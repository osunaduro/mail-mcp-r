# Modo remoto: el servidor queda accesible solo dentro de la red Docker
# "meka-network". Exponerlo a internet es responsabilidad de meka-infra: un
# proxy inverso (Nginx Proxy Manager) detrás de un túnel (Cloudflare Tunnel)
# unido a esa misma red. Ver infrastructure/README.md para el contrato que
# ese proxy/túnel debe cumplir.

# Used in the container name.
PROJECT_NAME=mail-mcp

# Ownership for files created by the container (no debería crear ninguno:
# el archivo de cuentas se monta de solo lectura).
MEKA_UID=1000
MEKA_GID=1000

# Absolute host path to the accounts file (ver home/config/accounts.example.yaml).
MAIL_MCP_CONFIG_PATH=/srv/meka/mail-mcp/accounts.yaml

# Authentication mode: api-key or oidc. Claude (web/Android/desktop) sólo
# acepta conectores remotos vía OAuth, así que este proyecto usa oidc por
# defecto. Nunca uses "none": este compose asume que algo externo lo alcanza.
MEKA_AUTH_MODE=oidc

# Requerido sólo si MEKA_AUTH_MODE=api-key. Generar con ../generate-api-key.sh.
# No commitear una clave real.
MEKA_API_KEY=

# Requerido sólo si MEKA_AUTH_MODE=oidc. Se completan tras crear el
# Provider/Application "mail-mcp" en Authentik (https://auth.mekaweb.com.ar).
# MEKA_OIDC_RESOURCE_URL es la URL pública canónica del endpoint MCP.
MEKA_OIDC_ISSUER=https://auth.mekaweb.com.ar/application/o/mail-mcp/
MEKA_OIDC_AUDIENCE=
MEKA_OIDC_JWKS_URL=https://auth.mekaweb.com.ar/application/o/mail-mcp/jwks/
MEKA_OIDC_RESOURCE_URL=https://mail.mekaweb.com.ar/mcp

# Token de servicio para la API REST plana (/api/v1/...), independiente del
# modo de auth de arriba (que sólo cubre el MCP en /mcp/). Siempre requerido
# para que la API REST responda: sin este valor, /api/v1/... da 503.
# Generar con ./generate-api-key.sh. No commitear un valor real.
MAIL_SERVICE_TOKEN=
